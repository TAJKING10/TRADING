# Copy this file to .env and fill in real values. Never commit .env.

# --- Exchange ---
EXCHANGE=kraken
API_KEY=
API_SECRET=

# Kraken has no spot sandbox, so DRY_RUN is the real safety switch (works on any exchange):
# connects with real keys, reads real balances/prices, computes the order it WOULD place,
# but never calls create_order. Set to false only when you want real orders sent.
DRY_RUN=true
# Only meaningful on exchanges that support a sandbox (e.g. Binance). Ignored on Kraken.
USE_TESTNET=false

# --- Trading scope ---
SYMBOL=BTC/USD
TIMEFRAME=4h

# Kraken's public OHLCV endpoint caps out around ~720 candles total, no deep history by
# date. So training data comes from a separate exchange with real historical depth
# (KuCoin). Crypto prices track tightly across major exchanges and our features are all
# relative (returns, RSI, etc.), so a model trained on KuCoin history generalizes fine to
# live Kraken prices. Live trading/balances/orders always use EXCHANGE (Kraken), never this.
# NOTE: Binance was the original choice but blocks GitHub Actions' datacenter IPs with
# HTTP 451 (geo-restriction) — KuCoin does not, and covers even more Kraken-listed coins.
TRAINING_DATA_EXCHANGE=kucoin
TRAINING_DATA_SYMBOL=BTC/USDT
# How much history to pull for training — more history = model has seen more regimes.
HISTORY_LOOKBACK_DAYS=1095

# --- Capital & risk controls ---
# Total USDT capital the bot is allowed to deploy. It will never see or touch funds beyond this.
CAPITAL_ALLOCATION_USDT=100
# Max fraction of capital risked on any single trade (stop-loss distance sized to this).
RISK_PER_TRADE_PCT=0.01
# Max fraction of capital in a position at once.
MAX_POSITION_PCT=0.5
# Bot halts for the day if realized+unrealized loss exceeds this fraction of capital.
DAILY_LOSS_LIMIT_PCT=0.03
# Bot halts entirely (manual restart required) if drawdown from peak equity exceeds this.
MAX_DRAWDOWN_PCT=0.10
# Stop-loss distance as a fraction of entry price.
STOP_LOSS_PCT=0.015
# Take-profit distance as a fraction of entry price.
TAKE_PROFIT_PCT=0.03
# Per-side taker fee as a fraction of trade value. Default is Kraken's base
# (lowest-volume) spot tier, 0.80% (Oct 2026) — NOT a discount tier. Check
# your actual account's fee tier at kraken.com/features/fee-schedule and set
# this to match; using an optimistic fee here fabricates backtest edges.
TAKER_FEE_PCT=0.008
# Assumed adverse price move on fill, each side, as a fraction of price.
SLIPPAGE_PCT=0.0005

# --- Model / retraining ---
RETRAIN_INTERVAL_HOURS=24
MODEL_DIR=artifacts

# --- Daily digest delivery (WhatsApp via CallMeBot) ---
# One-time setup: WhatsApp "+34 644 59 71 30" with "I allow callmebot to send me messages",
# it replies with your personal API key.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# --- Supabase scan history / accuracy tracking (optional; scan command skips sync if unset) ---
# Project API URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service role key ONLY — never the anon/publishable key. Get it from
# Supabase dashboard > Project Settings > API > service_role. Keep this out of
# git and the client-side dashboard; only use it server-side (local run or CI secret).
SUPABASE_SERVICE_ROLE_KEY=
